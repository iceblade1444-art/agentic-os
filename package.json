{
  "name": "agentic-os",
  "version": "1.11.2",
  "private": true,
  "type": "module",
  "description": "Agentic OS — dashboard + backend (LLM proxy, MCP host, integrations)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "prod:e2e": "node scripts/production-e2e.mjs",
    "prod:member-e2e": "node scripts/production-member-e2e.mjs",
    "smtp:verify": "node scripts/smtp-verify.mjs",
    "erp:verify": "node scripts/erp-verify.mjs",
    "db:dry-run": "node scripts/postgres-migrate.mjs --dry-run",
    "db:migrate": "node scripts/postgres-migrate.mjs",
    "db:verify": "node scripts/postgres-migrate.mjs --verify-only",
    "test": "node scripts/test-and-guard-data.mjs test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "^2.8.5",
    "express": "4.22.3",
    "http-proxy": "^1.18.1",
    "livekit-client": "^2.15.14",
    "nodemailer": "10.5.0",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "overrides": {
    "qs": "6.17.1",
    "@hono/node-server": "2.1.6",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.3",
    "ip-address": "10.7.6",
    "proxy-addr": "2.0.8"
  }
}
