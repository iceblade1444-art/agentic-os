# ============================================================
# Agentic OS — backend configuration
# Copy to `.env` and fill in. All keys are optional; anything
# left blank can be configured later in the UI (stored server-side).
# ============================================================

# Container's internal port (rarely change)
PORT=8787
# Published host port — change if the host already uses 8787 (e.g. 8790)
HOST_PORT=8787
# Host interface for the published port. Keep 127.0.0.1 when nginx is on this
# server. Use the server's private IP when a separate reverse proxy must connect.
BIND_ADDRESS=127.0.0.1

# Directory for the current JSON datastore (created automatically). During the
# staged PostgreSQL migration it remains the source of truth and rollback copy.
DATA_DIR=./data

# ---- PostgreSQL persistence ----
# Generate once with: openssl rand -hex 32
# The database is private to Docker and is not published on a host port.
POSTGRES_DB=agentic_os
POSTGRES_USER=agentic_os
POSTGRES_PASSWORD=
# Keep JSON as the source of truth while PostgreSQL is refreshed transactionally.
POSTGRES_SHADOW_SYNC_ENABLED=true
POSTGRES_SHADOW_SYNC_INTERVAL_MS=30000
POSTGRES_SHADOW_SYNC_DEBOUNCE_MS=500
# json = rollback, member-canary = compare SQL with JSON, member = SQL reads.
POSTGRES_READ_MODE=member

# CORS allowed origins (comma-separated) — leave blank for same-origin only
ALLOW_ORIGIN=

# ---- LLM providers (used by the chat proxy at /api/llm) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
HERMES_CHAT_SOCKET=/run/agentic-os/hermes-chat.sock
# Fallback model when the client doesn't send one
DEFAULT_MODEL=gpt-4o-mini

# ---- Optional integration credentials (also settable in the UI) ----
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_WEBHOOK_URL=

# ---- Obsidian vault (exposed to agents via the 'obsidian' MCP server) ----
OBSIDIAN_VAULT=./vault
# Start the bundled Obsidian MCP server with Agentic OS.
AUTO_CONNECT_OBSIDIAN=true

# Internal AgentOS runtime. Missions are planned by Hermes through this service.
AGENTOS_RUNTIME_URL=http://agentos-runtime:8765

# ---- Self-hosted Speech Studio ----
# Keep model weights outside Git. These directories are mounted read-only/inside
# the speech container and may contain several gigabytes.
SPEECH_MODELS_DIR=./speech-models
QWEN_TTS_MODELS_DIR=./speech-qwen-models
SPEECH_CPU_THREADS=6
# Random shared secret used only between the Node API and speech container.
SPEECH_INTERNAL_SECRET=

# Official Hermes Dashboard proxied at /hermes (HTTP + WebSocket). The compose
# file maps host.docker.internal to the Linux Docker host gateway.
HERMES_DASHBOARD_URL=http://host.docker.internal:9119
# Preferred production transport. Leave blank for direct local/Windows runs;
# docker-compose.yml sets the mounted Unix socket explicitly in production.
HERMES_DASHBOARD_SOCKET=

# MILA LiveKit signaling target. Agentic OS proxies public /rtc HTTP and
# WebSocket traffic here so the existing domain and TLS certificate are reused.
LIVEKIT_URL=http://host.docker.internal:7880

# Claude Code desktop workspace. The CLI runs inside the Agentic OS container;
# sessions are persisted in DATA_DIR and files stay under this mounted root.
CLAUDE_CODE_BIN=claude
# Leave these empty when Claude Code uses `claude auth login` (recommended).
# Set only for a dedicated Claude Code API key or compatible gateway.
CLAUDE_CODE_API_KEY=
CLAUDE_CODE_BASE_URL=
CLAUDE_CODE_WORKDIR=/app/work
# Keep cloned project files editable by the host user mounted into /app/work.
CLAUDE_CODE_WORKSPACE_UID=1000
CLAUDE_CODE_WORKSPACE_GID=1000
# Persist both Claude's settings directory and its root-level login file across deploys.
CLAUDE_CONFIG_DIR=/home/admilana/.claude
CLAUDE_CONFIG_FILE=/home/admilana/.claude.json
CLAUDE_CODE_TIMEOUT_MS=900000
CLAUDE_CODE_MODEL=sonnet

# ============================================================
# Security — SET THESE before exposing the server beyond localhost
# ============================================================
# Admin password / API token. Empty = auth DISABLED (fine for localhost only).
# Use a long random value, e.g.  openssl rand -hex 32
AUTH_TOKEN=
# Identity shown for the owner account in the Agentic OS sidebar.
CREATOR_NAME=Creator
CREATOR_EMAIL=
# Secret used to sign session cookies (defaults to AUTH_TOKEN). Random is best.
# It also encrypts MFA secrets. Do not rotate it without a migration and backup.
SESSION_SECRET=
# Set true when served over HTTPS (adds the Secure flag to the session cookie).
SECURE_COOKIE=false
# Allow public account creation. New accounts always start as Member.
ALLOW_REGISTRATION=false
# Public HTTPS origin used in verification/reset links.
PUBLIC_URL=https://agent.example.com
# Require new users to confirm email before web/mobile sign-in.
EMAIL_VERIFICATION_REQUIRED=false
# Provider-neutral SMTP delivery. Required before enabling email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mila Agentic OS <no-reply@example.com>"
# Host operations monitor (used by scripts/install-agentic-os-operations.sh).
OPS_BACKUP_RETENTION_DAYS=14
OPS_BACKUP_MAX_COUNT=14
# Optional public reverse-proxy/TLS probe, e.g. https://agent.example.com/api/health
OPS_PUBLIC_HEALTH_URL=
# Optional Slack-compatible webhook and/or Telegram destination for state changes.
OPS_ALERT_WEBHOOK_URL=
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
# Token the agentic-os MCP bridge uses to call the API (defaults to AUTH_TOKEN).
AGENTIC_OS_TOKEN=
# Allow adding *arbitrary-command* MCP servers from the UI/API (RCE surface). Keep false in prod.
ALLOW_CUSTOM_MCP=false
# When ALLOW_CUSTOM_MCP=true, only these base commands may be spawned:
MCP_ALLOWED_COMMANDS=npx,node,uvx,uv,python,python3,deno,bun,docker
