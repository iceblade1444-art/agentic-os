# ============================================================
# Agentic OS — backend configuration
# Copy to `.env` and fill in. All keys are optional; anything
# left blank can be configured later in the UI (stored server-side).
# ============================================================

# Container's internal port (rarely change)
PORT=8787
# Published host port — change if the host already uses 8787 (e.g. 8790)
HOST_PORT=8787
# Host interface for the published port. Keep 127.0.0.1 when nginx is on this
# server. Use the server's private IP when a separate reverse proxy must connect.
BIND_ADDRESS=127.0.0.1

# Directory for the JSON datastore (created automatically)
DATA_DIR=./data

# CORS allowed origins (comma-separated) — leave blank for same-origin only
ALLOW_ORIGIN=

# ---- LLM providers (used by the chat proxy at /api/llm) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Fallback model when the client doesn't send one
DEFAULT_MODEL=gpt-4o-mini

# ---- Optional integration credentials (also settable in the UI) ----
GITHUB_TOKEN=
NOTION_TOKEN=
SLACK_WEBHOOK_URL=

# ---- Obsidian vault (exposed to agents via the 'obsidian' MCP server) ----
OBSIDIAN_VAULT=./vault

# Internal AgentOS runtime. Missions are planned by Hermes through this service.
AGENTOS_RUNTIME_URL=http://agentos-runtime:8765

# Official Hermes Dashboard proxied at /hermes (HTTP + WebSocket). The compose
# file maps host.docker.internal to the Linux Docker host gateway.
HERMES_DASHBOARD_URL=http://host.docker.internal:9119
# Preferred production transport: a private Unix socket mounted into the Node container.
HERMES_DASHBOARD_SOCKET=/run/agentic-os/hermes-dashboard.sock

# ============================================================
# Security — SET THESE before exposing the server beyond localhost
# ============================================================
# Admin password / API token. Empty = auth DISABLED (fine for localhost only).
# Use a long random value, e.g.  openssl rand -hex 32
AUTH_TOKEN=
# Secret used to sign session cookies (defaults to AUTH_TOKEN). Random is best.
SESSION_SECRET=
# Set true when served over HTTPS (adds the Secure flag to the session cookie).
SECURE_COOKIE=false
# Token the agentic-os MCP bridge uses to call the API (defaults to AUTH_TOKEN).
AGENTIC_OS_TOKEN=
# Allow adding *arbitrary-command* MCP servers from the UI/API (RCE surface). Keep false in prod.
ALLOW_CUSTOM_MCP=false
# When ALLOW_CUSTOM_MCP=true, only these base commands may be spawned:
MCP_ALLOWED_COMMANDS=npx,node,uvx,uv,python,python3,deno,bun,docker
