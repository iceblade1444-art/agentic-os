  <script>
    let agentWorkerRuntimeConfirmationToken = null;
    let previewLifecycleFilter = null;
    let attemptFilters = {};
    let milaRecognition = null;
    let milaListening = false;

    async function getJson(path) {
      const res = await fetch(path);
      if (!res.ok) throw new Error(`${path}: ${res.status}`);
      return await res.json();
    }

    function el(id) { return document.getElementById(id); }
    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    }
    function escapeAttr(value) { return escapeHtml(value); }

    function toggleTechnicalPanels() {
      document.body.classList.toggle('legacy-panels-collapsed');
      return document.body.classList.contains('legacy-panels-collapsed');
    }

    function syncOpusShellMetrics(data = {}) {
      const projects = data.projects ?? el('projectCount')?.textContent ?? '—';
      const approvals = data.approvals ?? el('approvalCount')?.textContent ?? '—';
      document.querySelectorAll('[data-opus-metric="projects"]').forEach(node => { node.textContent = `${projects} projects`; });
      document.querySelectorAll('[data-opus-metric="approvals"]').forEach(node => { node.textContent = `${approvals} approvals`; });
      if (data.status && el('opusReadinessPill')) el('opusReadinessPill').textContent = data.status;
      if (el('opusStatusLine')) el('opusStatusLine').textContent = `Agentic OS live · projects=${projects} · approvals=${approvals} · approval-gated actions`;
      return { projects, approvals };
    }

    function activateAgenticTab(tabName) {
      const agenticTabButton = tabName;
      document.querySelectorAll('[data-agent-tab]').forEach(button => {
        button.classList.toggle('active', button.dataset.agentTab === tabName);
      });
      document.querySelectorAll('[data-agentic-panel]').forEach(panel => {
        panel.classList.toggle('active', panel.dataset.agenticPanel === tabName);
      });
      return agenticTabButton;
    }

    function activateMilaRoute(routeName, updateHash = true) {
      const milaRouteButton = routeName;
      const route = routeName || 'overview';
      document.querySelectorAll('[data-mila-route]').forEach(button => {
        button.classList.toggle('active', button.dataset.milaRoute === route);
      });
      document.querySelectorAll('[data-mila-route-panel]').forEach(panel => {
        panel.classList.toggle('active', panel.dataset.milaRoutePanel === route);
      });
      if (updateHash && window.location.hash !== `#${route}`) {
        window.history.replaceState(null, '', `#${route}`);
      }
      return milaRouteButton || route;
    }

    function syncMilaRouteFromHash() {
      const allowed = new Set(['overview', 'voice', 'agents', 'memory', 'builder', 'kanban', 'models', 'runtime', 'projects']);
      const route = (window.location.hash || '#overview').replace('#', '') || 'overview';
      return activateMilaRoute(allowed.has(route) ? route : 'overview', false);
    }

    function renderMilaAgentDock(data) {
      const counts = data.counts || {};
      const worker = data.worker || {};
      const report = data.latest_report || {};
      el('milaAgentDockSummary').innerHTML = `
        <strong>live worker state</strong> <span class="status ${worker.status === 'disabled' ? 'pending' : 'ok'}">${escapeHtml(worker.status || 'unknown')}</span><br>
        <span class="sub">projects=${counts.projects || 0} queue=${counts.queue_items || 0} runs=${counts.queue_runs || 0} pending_approvals=${counts.pending_approvals || 0}</span><br>
        <span class="sub">latest_report=${escapeHtml(report.relpath || '—')}</span>`;
      el('milaAgentDockLive').innerHTML = (data.agents || []).map(agent => `
        <div class="agent-pill" data-mila-agent-role="${escapeAttr(agent.role)}">
          <strong>${escapeHtml(agent.display_name)}</strong> <span class="status ${agent.status === 'ready' || agent.status === 'clear' || agent.status === 'watching' ? 'ok' : 'pending'}">${escapeHtml(agent.status)}</span><br>
          <span class="sub">${(agent.signals || []).map(escapeHtml).join(' · ')}</span>
        </div>`).join('');
      return data;
    }

    async function loadMilaAgentDock() {
      const data = await getJson('/api/mila/agent-dock');
      return renderMilaAgentDock(data);
    }

    function renderMilaMemoryGalaxy(data) {
      const counts = data.counts || {};
