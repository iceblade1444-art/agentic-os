<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mila Mission Control</title>
  <style>
    :root {
      --bg: #07111f;
      --panel: rgba(255,255,255,.08);
      --panel2: rgba(255,255,255,.12);
      --text: #f5f7fb;
      --muted: #aab7c8;
      --brand: #66e3ff;
      --warn: #ffd166;
      --ok: #4ade80;
      --line: rgba(255,255,255,.14);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: radial-gradient(circle at top left, rgba(102,227,255,.18), transparent 34rem), var(--bg);
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    header {
      padding: 28px 32px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    h1 { margin: 0; letter-spacing: -.05em; font-size: clamp(30px, 5vw, 56px); }
    .sub { color: var(--muted); margin-top: 6px; }
    main { padding: 28px 32px 46px; display: grid; gap: 22px; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 22px; padding: 22px; }
    .panel h2 { margin: 0 0 14px; letter-spacing: -.03em; }
    .metric { font-size: 42px; font-weight: 850; color: var(--brand); }
    .list { display: grid; gap: 12px; }
    .item { background: rgba(0,0,0,.18); border: 1px solid var(--line); border-radius: 16px; padding: 14px; }
    code { color: var(--brand); }
    .status { display: inline-flex; border-radius: 999px; padding: 5px 10px; background: var(--panel2); color: var(--muted); font-size: 13px; }
    .pending { color: var(--warn); }
    .ok { color: var(--ok); }
    button { border: 0; border-radius: 999px; padding: 12px 16px; font-weight: 800; color: #06101d; background: linear-gradient(135deg, #66e3ff, #9b7cff); cursor: pointer; }
    form { display: grid; gap: 10px; }
    input, textarea { width: 100%; border: 1px solid var(--line); border-radius: 14px; background: rgba(0,0,0,.22); color: var(--text); padding: 12px; font: inherit; }
    textarea { resize: vertical; }
    .mila-hero { position: relative; overflow: hidden; background: linear-gradient(135deg, rgba(102,227,255,.16), rgba(155,124,255,.13)), rgba(255,255,255,.07); }
    .mila-hero::after { content: ""; position: absolute; inset: auto -12% -45% auto; width: 420px; height: 420px; border-radius: 999px; background: radial-gradient(circle, rgba(102,227,255,.28), transparent 68%); pointer-events: none; }
    .mila-layout { position: relative; display: grid; grid-template-columns: minmax(220px, .75fr) minmax(280px, 1.25fr); gap: 20px; align-items: stretch; z-index: 1; }
    .mila-orb-wrap { display: grid; place-items: center; min-height: 280px; border: 1px solid var(--line); border-radius: 24px; background: radial-gradient(circle at 50% 45%, rgba(102,227,255,.24), rgba(0,0,0,.18) 42%, rgba(0,0,0,.28)); }
    .mila-orb { width: 168px; height: 168px; border-radius: 50%; background: radial-gradient(circle at 35% 28%, #fff, #66e3ff 22%, #9b7cff 58%, #101b33 100%); box-shadow: 0 0 42px rgba(102,227,255,.42), inset 0 0 40px rgba(255,255,255,.18); animation: milaPulse 2.8s ease-in-out infinite; }
    .mila-orb.listening { animation-duration: 1.05s; box-shadow: 0 0 70px rgba(74,222,128,.58), inset 0 0 42px rgba(255,255,255,.24); }
    .mila-controls { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 12px 0; }
    .mila-status-line { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-top: 10px; }
    .mila-log { min-height: 156px; white-space: pre-wrap; }
    .agentic-os-shell { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 18px; align-items: stretch; }
    .agentic-sidebar { position: sticky; top: 18px; align-self: start; display: grid; gap: 10px; padding: 16px; border: 1px solid var(--line); border-radius: 24px; background: linear-gradient(180deg, rgba(255,255,255,.12), rgba(255,255,255,.045)); }
    .agentic-tab-button { display: flex; justify-content: space-between; gap: 12px; width: 100%; color: var(--text); background: rgba(255,255,255,.08); border: 1px solid var(--line); }
    .agentic-tab-button.active { color: #06101d; background: linear-gradient(135deg, #66e3ff, #9b7cff); }
    .agentic-stage { display: grid; gap: 16px; }
    .agentic-tab-panel { display: none; }
    .agentic-tab-panel.active { display: block; }
    .agentic-hero-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: 16px; }
    .agent-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .agent-pill { border: 1px solid var(--line); border-radius: 18px; padding: 14px; background: rgba(0,0,0,.18); }
    .memory-galaxy { position: relative; min-height: 240px; overflow: hidden; border-radius: 22px; background: radial-gradient(circle at 30% 35%, rgba(102,227,255,.34), transparent 24%), radial-gradient(circle at 70% 62%, rgba(155,124,255,.32), transparent 28%), rgba(0,0,0,.24); }
    .memory-node { position: absolute; border-radius: 999px; padding: 9px 12px; border: 1px solid var(--line); background: rgba(7,17,31,.8); box-shadow: 0 0 24px rgba(102,227,255,.18); }
    .preview-stage { min-height: 260px; border: 1px solid var(--line); border-radius: 22px; background: linear-gradient(135deg, rgba(102,227,255,.11), rgba(155,124,255,.13)), rgba(0,0,0,.22); padding: 18px; }
    .kanban-mini { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .kanban-mini .item { min-height: 96px; }
    .mila-primary-routes { display: flex; gap: 10px; flex-wrap: wrap; padding: 14px 32px 0; }
    .mila-route-button { color: var(--text); background: rgba(255,255,255,.08); border: 1px solid var(--line); }
    .mila-route-button.active { color: #06101d; background: linear-gradient(135deg, #66e3ff, #9b7cff); }
    .mila-route-panel { display: none; }
    .mila-route-panel.active { display: grid; gap: 22px; }
    .milaJarvisWorkspace { margin: 14px 32px; border: 1px solid rgba(64, 221, 255, .28); border-radius: 24px; background: radial-gradient(circle at top left, rgba(64,221,255,.16), rgba(9,12,24,.86) 42%, rgba(4,6,14,.94)); box-shadow: 0 24px 80px rgba(0,0,0,.36); padding: 18px; }
    .jarvis-focus-strip { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); gap: 12px; }
    .jarvis-live-signal { border: 1px solid rgba(122, 255, 190, .32); border-radius: 16px; padding: 12px; background: rgba(122,255,190,.07); }
    .jarvis-safety-ribbon { margin-top: 12px; padding: 10px 12px; border-radius: 14px; background: rgba(255, 203, 107, .12); border: 1px solid rgba(255,203,107,.28); }
    .jarvis-workspace-lanes { display: grid; grid-template-columns: repeat(3, minmax(160px, 1fr)); gap: 12px; margin-top: 12px; }
    .jarvis-lane { border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 12px; background: rgba(255,255,255,.045); }
    :root { --opus-bg: #03050b; --opus-ink: #f6fbff; --opus-muted: #7f91aa; --opus-cyan: #5ee7ff; --opus-violet: #9d7bff; --opus-amber: #ffd37a; --opus-glass: rgba(8, 14, 28, .66); }
    body.opus-mode { background: #03050b; overflow-x: hidden; }
    body.opus-mode::before { content: ""; position: fixed; inset: 0; z-index: -2; background: radial-gradient(circle at 18% 18%, rgba(94,231,255,.22), transparent 30vw), radial-gradient(circle at 76% 20%, rgba(157,123,255,.19), transparent 34vw), linear-gradient(180deg, #03050b 0%, #06101f 55%, #02030a 100%); }
    body.opus-mode::after { content: ""; position: fixed; inset: 0; z-index: -1; opacity: .28; pointer-events: none; mix-blend-mode: screen; background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(circle at 50% 20%, black, transparent 76%); }
    .opus-command-center { position: relative; min-height: calc(100vh - 18px); margin: 18px; border-radius: 34px; overflow: hidden; border: 1px solid rgba(148, 220, 255, .22); background: linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.025)); box-shadow: 0 30px 120px rgba(0,0,0,.56), inset 0 1px 0 rgba(255,255,255,.12); backdrop-filter: blur(26px) saturate(1.35); }
    .opus-command-center::before { content: ""; position: absolute; inset: -35%; background: conic-gradient(from 110deg, transparent, rgba(94,231,255,.22), transparent, rgba(157,123,255,.18), transparent); animation: opusOrbit 16s linear infinite; opacity: .46; }
    .opus-command-center::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 0 62%, rgba(94,231,255,.08) 63%, transparent 64%); background-size: 100% 18px; animation: opusScan 7s ease-in-out infinite; opacity: .35; pointer-events: none; }
    .opus-shell-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 92px minmax(0, 1fr) 330px; gap: 18px; min-height: calc(100vh - 36px); padding: 18px; }
    .opus-left-rail { display: grid; align-content: space-between; justify-items: center; padding: 18px 10px; border-radius: 26px; background: rgba(0,0,0,.26); border: 1px solid rgba(255,255,255,.1); }
    .opus-brand-mark { width: 54px; height: 54px; border-radius: 20px; display: grid; place-items: center; color: #05101a; font-weight: 950; background: radial-gradient(circle at 35% 20%, #fff, var(--opus-cyan) 34%, var(--opus-violet)); box-shadow: 0 0 42px rgba(94,231,255,.42); }
    .opus-rail-stack { display: grid; gap: 12px; }
    .opus-rail-dot { width: 46px; height: 46px; border-radius: 18px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.06); color: var(--opus-ink); display: grid; place-items: center; font-weight: 900; }
    .opus-hero-stage { display: grid; grid-template-rows: auto minmax(360px, 1fr) auto; gap: 18px; }
    .opus-status-ticker { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 14px 18px; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: rgba(0,0,0,.24); backdrop-filter: blur(18px); }
    .opus-kicker { color: var(--opus-cyan); letter-spacing: .22em; text-transform: uppercase; font-size: 12px; font-weight: 900; }
    .opus-title { margin: 0; font-size: clamp(44px, 7vw, 104px); line-height: .88; letter-spacing: -.08em; text-wrap: balance; }
    .opus-title span { color: transparent; background: linear-gradient(115deg, #fff, var(--opus-cyan), var(--opus-violet)); -webkit-background-clip: text; background-clip: text; }
    .opus-command-bar { display: grid; grid-template-columns: 1fr auto auto; gap: 10px; padding: 12px; border-radius: 24px; border: 1px solid rgba(255,255,255,.14); background: rgba(0,0,0,.34); box-shadow: inset 0 1px 0 rgba(255,255,255,.08); }
    .opus-command-bar input { border-radius: 18px; background: rgba(255,255,255,.07); }
    .opus-orbital-system { position: relative; min-height: 480px; border-radius: 34px; border: 1px solid rgba(255,255,255,.12); background: radial-gradient(circle at center, rgba(94,231,255,.2), transparent 28%), radial-gradient(circle at 58% 42%, rgba(157,123,255,.2), transparent 34%), rgba(0,0,0,.22); overflow: hidden; }
    .opus-core-orb { position: absolute; left: 50%; top: 49%; width: 190px; height: 190px; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle at 35% 26%, #fff, var(--opus-cyan) 18%, var(--opus-violet) 56%, #101529 100%); box-shadow: 0 0 70px rgba(94,231,255,.56), 0 0 140px rgba(157,123,255,.28), inset 0 0 46px rgba(255,255,255,.24); animation: opusBreath 3.4s ease-in-out infinite; }
    .opus-ring { position: absolute; left: 50%; top: 50%; border: 1px solid rgba(148,220,255,.28); border-radius: 50%; transform: translate(-50%, -50%); }
    .opus-ring.one { width: 360px; height: 220px; rotate: -18deg; } .opus-ring.two { width: 560px; height: 330px; rotate: 18deg; } .opus-ring.three { width: 720px; height: 430px; rotate: -4deg; }
    .opus-memory-constellation { position: absolute; inset: 22px; pointer-events: none; }
    .opus-node { position: absolute; min-width: 112px; padding: 10px 12px; border: 1px solid rgba(255,255,255,.16); border-radius: 18px; background: rgba(4,9,20,.76); box-shadow: 0 12px 40px rgba(0,0,0,.34), 0 0 30px rgba(94,231,255,.13); }
    .opus-node strong { display: block; } .opus-node small { color: var(--opus-muted); }
    .opus-agent-dock { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .opus-agent-card { padding: 12px; border-radius: 20px; border: 1px solid rgba(255,255,255,.13); background: rgba(255,255,255,.055); min-height: 86px; }
    .opus-right-stack { display: grid; gap: 14px; align-content: start; }
    .opus-side-card { border-radius: 26px; padding: 16px; border: 1px solid rgba(255,255,255,.12); background: rgba(0,0,0,.28); backdrop-filter: blur(18px); }
    .legacy-panels-collapsed main > section:not(#opusAgenticShell):not(.mila-route-panel) { display: none; }
    .route-note { border: 1px dashed var(--line); border-radius: 18px; padding: 12px 14px; color: var(--muted); background: rgba(0,0,0,.14); }
    @keyframes opusOrbit { to { transform: rotate(360deg); } }
    @keyframes opusScan { 0%, 100% { transform: translateY(-18%); } 50% { transform: translateY(18%); } }
    @keyframes opusBreath { 0%, 100% { transform: translate(-50%, -50%) scale(.98); filter: saturate(1); } 50% { transform: translate(-50%, -50%) scale(1.04); filter: saturate(1.25); } }
    @keyframes milaPulse { 0%, 100% { transform: scale(.98); filter: saturate(1); } 50% { transform: scale(1.04); filter: saturate(1.24); } }
    @media (prefers-reduced-motion: reduce) { .mila-orb { animation: none; } }
    @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } header { align-items: flex-start; flex-direction: column; } .mila-layout { grid-template-columns: 1fr; } .agentic-os-shell, .agentic-hero-grid, .agent-card-grid, .kanban-mini { grid-template-columns: 1fr; } .agentic-sidebar { position: static; } }
  </style>
</head>
<body class="opus-mode legacy-panels-collapsed">
  <header>
    <div>
      <h1>Мила Mission Control</h1>
      <div class="sub">Jarvis-style local AI operator powered by Hermes Agent, safe approval gates, and the AgentOS Mission Control core</div>
    </div>
    <button onclick="refreshAll()">Refresh</button>
  </header>

  <nav class="mila-primary-routes" id="milaPrimaryRoutes" aria-label="Mila dashboard routes">
    <button class="mila-route-button active" data-mila-route="overview" onclick="activateMilaRoute('overview')">Overview</button>
    <button class="mila-route-button" data-mila-route="voice" onclick="activateMilaRoute('voice')">Voice</button>
    <button class="mila-route-button" data-mila-route="agents" onclick="activateMilaRoute('agents')">Agents</button>
    <button class="mila-route-button" data-mila-route="memory" onclick="activateMilaRoute('memory')">Memory</button>
    <button class="mila-route-button" data-mila-route="builder" onclick="activateMilaRoute('builder')">Builder</button>
    <button class="mila-route-button" data-mila-route="kanban" onclick="activateMilaRoute('kanban')">Kanban</button>
    <button class="mila-route-button" data-mila-route="models" onclick="activateMilaRoute('models')">Models</button>
    <button class="mila-route-button" data-mila-route="runtime" onclick="activateMilaRoute('runtime')">Runtime</button>
    <button class="mila-route-button" data-mila-route="projects" onclick="activateMilaRoute('projects')">Workspaces</button>
  </nav>

  <main>
    <section class="opus-command-center" id="opusAgenticShell" aria-label="Agentic OS // Mila cinematic command center">
      <div class="opus-shell-grid">
        <aside class="opus-left-rail">
          <div class="opus-brand-mark">M</div>
          <div class="opus-rail-stack">
            <button class="opus-rail-dot" onclick="activateMilaRoute('voice')">V</button>
            <button class="opus-rail-dot" onclick="activateMilaRoute('agents')">A</button>
            <button class="opus-rail-dot" onclick="activateMilaRoute('memory')">G</button>
            <button class="opus-rail-dot" onclick="activateMilaRoute('builder')">B</button>
          </div>
          <button class="opus-rail-dot" onclick="toggleTechnicalPanels()">⌘</button>
        </aside>

        <section class="opus-hero-stage">
          <div class="opus-status-ticker">
            <div><div class="opus-kicker">Agentic OS // Mila</div><strong>focused command center</strong></div>
            <span class="status ok" id="opusReadinessPill">ready_local</span>
            <button onclick="toggleTechnicalPanels()">Show technical panels</button>
          </div>
          <div class="opus-orbital-system">
            <div class="opus-ring one"></div><div class="opus-ring two"></div><div class="opus-ring three"></div>
            <div class="opus-core-orb" aria-hidden="true"></div>
            <div class="opus-memory-constellation">
              <div class="opus-node" style="left:7%;top:13%"><strong>Projects</strong><small data-opus-metric="projects">—</small></div>
              <div class="opus-node" style="right:8%;top:18%"><strong>Approvals</strong><small data-opus-metric="approvals">—</small></div>
              <div class="opus-node" style="left:13%;bottom:16%"><strong>Memory</strong><small>galaxy live</small></div>
              <div class="opus-node" style="right:12%;bottom:14%"><strong>Models</strong><small>providers ready</small></div>
            </div>
          </div>
          <div class="opus-agent-dock">
            <div class="opus-agent-card" data-opus-agent="orchestrator"><strong>Orchestrator</strong><br><span class="sub">routes work</span></div>
            <div class="opus-agent-card" data-opus-agent="builder"><strong>Builder</strong><br><span class="sub">plans apps</span></div>
            <div class="opus-agent-card" data-opus-agent="qa"><strong>QA Judge</strong><br><span class="sub">keeps tests green</span></div>
            <div class="opus-agent-card" data-opus-agent="guard"><strong>Approval Guard</strong><br><span class="sub">blocks risky actions</span></div>
          </div>
          <div class="opus-command-bar">
            <input id="opusCommandInput" placeholder="Мила, build, inspect, approve, preview…" />
            <button onclick="el('commandInput').value = el('opusCommandInput').value; document.getElementById('commandForm').requestSubmit();">Run</button>
            <button onclick="activateMilaRoute('builder')">Builder</button>
          </div>
        </section>

        <aside class="opus-right-stack">
          <div class="opus-side-card"><div class="opus-kicker">Live system</div><h2 data-opus-metric="projects">— projects</h2><p class="sub">workspace, tasks, reports and memory are live.</p></div>
          <div class="opus-side-card"><div class="opus-kicker">Safety</div><h2 data-opus-metric="approvals">— approvals</h2><p class="sub">actions stay behind approval gates; no secrets surface in UI.</p></div>
          <div class="opus-side-card"><div class="opus-kicker">Preview stage</div><p class="sub" id="opusStatusLine">Mila is ready for voice-first command and build loops.</p></div>
        </aside>
      </div>
    </section>
    <section class="mila-route-panel active" id="milaRouteOverview" data-mila-route-panel="overview">
      <div class="route-note">Overview route: System Status, Production Readiness, Daily Digest, and high-level launch state.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteVoice" data-mila-route-panel="voice">
      <div class="route-note">Voice route: Мила realtime voice-to-voice UX, Voice Adapter, Gemini session, provider health, and Voice Transcripts.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteAgents" data-mila-route-panel="agents">
      <div class="route-note">Agents route: agent dock, worker queue, specialist profiles, and future live agent states.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteMemory" data-mila-route-panel="memory">
      <div class="route-note">Memory route: Obsidian memory galaxy, notes, logs, reports, skills, and shared second brain.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteBuilder" data-mila-route-panel="builder">
      <div class="route-note">Builder route: app builder idea → plan → approval → build → preview → iterate.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteKanban" data-mila-route-panel="kanban">
      <div class="route-note">Kanban route: Kanban board studio and multi-agent flow.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteModels" data-mila-route-panel="models">
      <div class="route-note">Models route: model/plugin hub for Gemini, Claude, Kimi, GLM, OpenRouter, and local models.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteRuntime" data-mila-route-panel="runtime">
      <div class="route-note">Runtime route: Approvals, Event Log, worker daemon, trace exports, retention, confirmations, and safety gates.</div>
    </section>
    <section class="mila-route-panel" id="milaRouteProjects" data-mila-route-panel="projects">
      <div class="route-note">Projects route: Projects, tasks, linked Hermes tasks, queue runs, and project artifacts.</div>
    </section>
    <section class="milaJarvisWorkspace" id="milaJarvisWorkspace" aria-label="Mila Jarvis focused command center">
      <div class="jarvis-focus-strip">
        <div class="jarvis-live-signal"><strong>Voice-first</strong><br><span class="sub">Gemini Live + browser voice + command bridge</span></div>
        <div class="jarvis-live-signal"><strong>Agents online</strong><br><span class="sub">dock, queue, QA, approvals</span></div>
        <div class="jarvis-live-signal"><strong>Memory galaxy</strong><br><span class="sub">projects, reports, events, transcripts</span></div>
        <div class="jarvis-live-signal"><strong>Model hub</strong><br><span class="sub">providers ready without secret surfaces</span></div>
      </div>
      <div class="jarvis-safety-ribbon">focused command center · approval-gated actions · no-secret surfaces · local-first dashboard</div>
      <div class="jarvis-workspace-lanes">
        <div class="jarvis-lane"><strong>Ask</strong><br><span class="sub">voice/chat entry</span></div>
        <div class="jarvis-lane"><strong>Approve</strong><br><span class="sub">safe gates before risky actions</span></div>
        <div class="jarvis-lane"><strong>Build / Preview</strong><br><span class="sub">agents, app builder, Kanban, reports</span></div>
      </div>
      <div class="item" id="milaVisualPolishPanel">Loading visual polish metadata...</div>
    </section>

    <section class="panel" id="agenticOsShell" aria-label="Agentic OS Command Center">
      <div class="agentic-os-shell">
        <aside class="agentic-sidebar" id="agenticSidebar">
          <strong>Agentic OS Command Center</strong>
          <span class="sub">Inspired by video A75zZTFw_o0: whole team of AI workers, Obsidian memory galaxy, plug in new models, voice-activated agent, Kanban board, app builder, daily changelog, preview stage.</span>
          <button class="agentic-tab-button active" data-agent-tab="mila" onclick="activateAgenticTab('mila')">Мила <span>voice</span></button>
          <button class="agentic-tab-button" data-agent-tab="agents" onclick="activateAgenticTab('agents')">Agents <span>team</span></button>
