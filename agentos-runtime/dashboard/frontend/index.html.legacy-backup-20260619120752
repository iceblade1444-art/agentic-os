    async function runAgentWorkerRuntimeTick(confirmExecute = false) {
      let payload = {};
      if (confirmExecute) {
        if (!agentWorkerRuntimeConfirmationToken) {
          alert('Runtime confirm preflight blocked: missing confirmation_token');
          return { status: 'confirmation_preflight_blocked', decision: 'confirmation_preflight_blocked', preflight: { status: 'confirmation_token_not_found', can_execute: false } };
        }
        const preflight = await validateAgentWorkerRuntimePreviewToken(agentWorkerRuntimeConfirmationToken);
        if (!preflight.can_execute) {
          alert(`Runtime confirm preflight blocked: ${preflight.status}; reason=${preflight.reason || 'unknown'}`);
          return { status: 'confirmation_preflight_blocked', decision: 'confirmation_preflight_blocked', preflight };
        }
        payload = { confirm_execute: true, confirmation_token: agentWorkerRuntimeConfirmationToken, preflight_gate: true };
      }
      const result = await postJson('/api/agent-worker/runtime-tick', payload);
      if (result.status === 'execute_confirmation_required' && result.confirmation) {
        agentWorkerRuntimeConfirmationToken = result.confirmation.token;
      }
      alert(`Runtime tick: ${result.status}; planned=${result.planned}; executed=${result.executed}`);
      await Promise.all([loadAgentWorkerStatus(), loadAgentWorkerRuntimeAudits(), loadAgentWorkerRuntimeConfirmAttempts(), loadAgentWorkerRuntimePreviews(), loadAgentQueue(), loadAgentQueueRuns(), loadEvents(), loadProjects()]);
    }

