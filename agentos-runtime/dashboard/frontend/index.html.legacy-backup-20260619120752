    function milaSetStatus(label, ok = false) {
      if (!el('milaStatus')) return;
      el('milaStatus').textContent = label;
      el('milaStatus').className = `status ${ok ? 'ok' : 'pending'}`;
    }

    function milaSetListening(listening) {
      milaListening = listening;
      if (el('milaOrb')) el('milaOrb').classList.toggle('listening', listening);
      milaSetStatus(listening ? 'listening' : 'ready', !listening);
    }

    function milaRecognitionConstructor() {
      return window.SpeechRecognition || window.webkitSpeechRecognition;
    }

    function milaUpdateVoiceSupport() {
      const supported = Boolean(milaRecognitionConstructor());
      if (el('milaRecognitionSupport')) {
        el('milaRecognitionSupport').textContent = supported ? 'SpeechRecognition ready' : 'SpeechRecognition unavailable — type instead';
        el('milaRecognitionSupport').className = `status ${supported ? 'ok' : 'pending'}`;
      }
      return supported;
    }

    async function loadMilaDesktopPackage() {
      const data = await getJson('/api/mila/desktop-package');
      if (el('milaPackage')) {
        const scripts = data.script_status || {};
        const ready = Object.values(scripts).every(item => item && item.exists === true);
        el('milaPackage').textContent = ready ? 'desktop package ready' : 'desktop package incomplete';
        el('milaPackage').className = `status ${ready ? 'ok' : 'pending'}`;
      }
      milaUpdateVoiceSupport();
      return data;
    }

    function renderMilaTrayPackage(data) {
      const scripts = (data.scripts || []).map(item => `${item.exists ? '✓' : '…'} ${item.relpath} (${item.size || 0} bytes)`).join('\n');
      el('milaTrayPackageResult').textContent = `Native tray package: ${data.status}\ncapabilities=${(data.capabilities || []).join(', ')}\nOpen dashboard: ${data.dashboard_url}\nwrites_enabled=${data.writes_enabled}\nsecrets_included=${data.secrets_included}\n${scripts}`;
      return data;
    }

    async function loadMilaTrayPackage() {
      const data = await getJson('/api/mila/tray-package');
      return renderMilaTrayPackage(data);
    }

    function renderMilaVisualPolish(data) {
      const markers = (data.polish_markers || []).filter(item => item.present).length;
      el('milaVisualPolishPanel').innerHTML = `<strong>focused command center</strong> <span class="status ok">${data.status}</span><br><span class="sub">mode=${escapeHtml(data.layout?.mode || 'unknown')} · routes=${data.layout?.routes || 0} · polish_markers=${markers}</span><br><span class="sub">${(data.principles || []).map(escapeHtml).join(' · ')}</span>`;
      return data;
    }

    async function loadMilaVisualPolish() {
      const data = await getJson('/api/mila/visual-polish');
      return renderMilaVisualPolish(data);
    }

    function milaSpeak(text) {
      const message = String(text || '').trim();
      if (!message) return;
      if (!('speechSynthesis' in window)) {
        el('milaSessionResult').textContent += `\n\nVoice output unavailable: ${message}`;
        return;
      }
      const utterance = new SpeechSynthesisUtterance(message);
      utterance.lang = 'ru-RU';
      utterance.rate = 1;
      utterance.pitch = 1.02;
      window.speechSynthesis.cancel();
      window.speechSynthesis.speak(utterance);
    }

    function milaResponseText(result) {
      const command = result.command || {};
      const intent = command.intent || 'unknown';
      if (result.status === 'blocked') return 'Я вижу команду, но голосовой провайдер пока не готов.';
      if (result.status === 'failed') return 'Я не смогла надежно распознать безопасное действие. Попробуй сказать проще.';
      if (intent === 'show_digest') {
        const digest = command.result || {};
        return `Дайджест готов. Проектов: ${digest.projects || 0}. Ожидающих подтверждения: ${digest.pending_approvals || 0}.`;
      }
      if (intent === 'create_goal') return `Готово. Цель создана: ${(command.result || {}).goal || 'без названия'}.`;
      if (intent === 'request_approval') return 'Запрос подтверждения создан. Опасные действия остаются за approval gates.';
      if (intent === 'kanban_export') return 'Kanban export создан.';
      return 'Готово. Команда прошла через безопасный контур AgentOS.';
    }

    async function milaSubmitUtterance() {
      const text = el('milaTranscriptInput').value.trim();
      if (!text) return alert('Скажи или введи команду для Милы.');
      milaSetStatus('thinking');
      el('milaSessionResult').textContent = 'Мила думает…';
      const result = await postJson('/api/voice-session', { provider: 'gemini_live', text });
      const responseText = milaResponseText(result);
      el('milaSessionResult').textContent = `${responseText}\n\n${JSON.stringify(result, null, 2)}`;
      milaSpeak(responseText);
      milaSetStatus(result.status === 'passed' ? 'ready' : result.status, result.status === 'passed');
      await Promise.all([loadVoiceTranscripts(), loadEvents(), loadVoiceHealth(), loadProductionReadiness()]);
      return result;
    }

    function milaStartListening() {
      const Recognition = milaRecognitionConstructor();
      if (!Recognition) {
        milaUpdateVoiceSupport();
        milaSetStatus('type mode');
        return alert('SpeechRecognition не поддерживается этим браузером. Введи команду вручную.');
      }
      if (milaListening && milaRecognition) return;
      milaRecognition = new Recognition();
      milaRecognition.lang = 'ru-RU';
      milaRecognition.continuous = false;
      milaRecognition.interimResults = true;
      milaRecognition.onstart = () => milaSetListening(true);
      milaRecognition.onerror = (event) => {
        milaSetListening(false);
        el('milaSessionResult').textContent = `SpeechRecognition error: ${event.error || 'unknown'}`;
      };
      milaRecognition.onend = () => milaSetListening(false);
      milaRecognition.onresult = (event) => {
        let transcript = '';
        let finalTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; i += 1) {
          const chunk = event.results[i][0].transcript;
          transcript += chunk;
          if (event.results[i].isFinal) finalTranscript += chunk;
        }
        el('milaTranscriptInput').value = (finalTranscript || transcript).trim();
        if (finalTranscript.trim()) milaSubmitUtterance();
      };
      milaRecognition.start();
    }

    function milaStopListening() {
      if (milaRecognition) milaRecognition.stop();
      milaSetListening(false);
    }

    async function loadStatus() {
      const res = await fetch('/api/status');
      if (!res.ok) throw new Error(`/api/status: ${res.status}`);
      const data = await res.json();
