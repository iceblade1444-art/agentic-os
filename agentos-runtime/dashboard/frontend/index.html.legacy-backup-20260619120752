        <strong>live second brain</strong> <span class="status ok">${(data.nodes || []).length} nodes</span><br>
        <span class="sub">projects=${counts.projects || 0} reports=${counts.reports || 0} events=${counts.events || 0} voice-transcripts=${counts.voice_transcripts || 0}</span><br>
        <span class="sub">latest_report=${escapeHtml(report.relpath || '—')}</span>`;
      const positions = [[8,18],[42,12],[68,32],[22,62],[55,70],[73,68],[34,42],[80,16]];
      el('milaMemoryGalaxyLive').innerHTML = (data.nodes || []).map((node, index) => {
        const pos = positions[index % positions.length];
        return `<span class="memory-node" data-memory-node-id="${escapeAttr(node.id)}" style="left:${pos[0]}%;top:${pos[1]}%">${escapeHtml(node.label)} · ${node.count || 0}</span>`;
      }).join('');
      return data;
    }

