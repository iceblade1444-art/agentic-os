    function runtimeTraceExportRetentionParams() {
      const maxActive = prompt('Max active runtime trace exports to keep', '10');
      if (maxActive === null) return null;
      const maxArchived = prompt('Max archived runtime trace exports to keep', '50');
      if (maxArchived === null) return null;
      const olderThanDays = prompt('Also archive/prune artifacts older than N days (blank disables age rule)', '');
      if (olderThanDays === null) return null;
      return { max_active: maxActive, max_archived: maxArchived, older_than_days: olderThanDays || null };
    }

    function renderRuntimeTraceExportRetention(result) {
      const counts = result.counts || (result.preview ? result.preview.counts : {}) || {};
      const archiveCandidates = result.archive_candidates || (result.preview ? result.preview.archive_candidates : []) || [];
      const pruneCandidates = result.prune_candidates || (result.preview ? result.preview.prune_candidates : []) || [];
      const archived = result.archived || [];
      const pruned = result.pruned || [];
      el('agentWorkerRuntimeTraceExportRetention').innerHTML = `
        <div class="item">
          <strong>${result.decision || result.status}</strong> <span class="status ${result.will_apply ? 'pending' : 'ok'}">${result.status}</span><br>
          <span class="sub">active_total=${counts.active_total ?? '—'} archived_total=${counts.archived_total ?? '—'} archive_candidates=${counts.archive_candidates ?? archived.length} prune_candidates=${counts.prune_candidates ?? pruned.length}</span><br>
          <span class="sub">policy=${JSON.stringify(result.policy || (result.preview ? result.preview.policy : {}))}</span><br>
          <span class="sub">archive_candidates=${archiveCandidates.map(item => item.one_shot_run_id || item.source_relpath).join(', ') || '—'}</span><br>
          <span class="sub">prune_candidates=${pruneCandidates.map(item => item.archive_id || item.source_relpath).join(', ') || '—'}</span><br>
          <span class="sub">archived=${archived.map(item => item.archive_relpath).join(', ') || '—'}</span><br>
          <span class="sub">pruned=${pruned.map(item => item.pruned_relpath).join(', ') || '—'}</span>
        </div>`;
    }

    async function previewAgentWorkerRuntimeTraceExportRetention() {
      const params = runtimeTraceExportRetentionParams();
      if (!params) return null;
      const query = new URLSearchParams();
      if (params.max_active !== null && params.max_active !== '') query.set('max_active', params.max_active);
      if (params.max_archived !== null && params.max_archived !== '') query.set('max_archived', params.max_archived);
      if (params.older_than_days !== null && params.older_than_days !== '') query.set('older_than_days', params.older_than_days);
      const res = await fetch(`/api/agent-worker/runtime-trace-export-retention/preview?${query.toString()}`);
      if (!res.ok) throw new Error(`/api/agent-worker/runtime-trace-export-retention/preview: ${res.status}`);
      const result = await res.json();
      renderRuntimeTraceExportRetention(result);
      alert(`Retention preview: archive=${result.counts.archive_candidates}; prune=${result.counts.prune_candidates}`);
      return result;
    }

    async function applyAgentWorkerRuntimeTraceExportRetention() {
      const params = runtimeTraceExportRetentionParams();
      if (!params) return null;
      const ok = confirm(`Apply runtime trace export retention? This archives/prunes only markdown export artifacts; operational ledgers stay unchanged.`);
      if (!ok) return { status: 'runtime_trace_export_retention_cancelled' };
      const result = await postJson('/api/agent-worker/runtime-trace-export-retention/apply', { ...params, confirm_retention: true, reason: 'operator_retention_from_dashboard' });
      renderRuntimeTraceExportRetention(result);
      alert(`Retention apply: ${result.status}; archived=${(result.archived || []).length}; pruned=${(result.pruned || []).length}`);
      await Promise.all([loadAgentWorkerRuntimeTraceExports(), loadAgentWorkerRuntimeTraceExportArchives()]);
      return result;
    }

