      const suffix = params.toString() ? `?${params.toString()}` : '';
      const res = await fetch(`/api/voice-transcripts${suffix}`);
      if (!res.ok) throw new Error(`/api/voice-transcripts: ${res.status}`);
      const data = await res.json();
      el('voiceTranscripts').innerHTML = data.items.length ? data.items.map(t => `
        <div class="item">
          <strong>${t.provider}</strong> <span class="status ${t.status === 'passed' ? 'ok' : 'pending'}">${t.status}</span><br>
          <span class="sub">${t.created_at || ''}: ${t.recognized_text || (t.reasons || []).join(', ') || 'no text'}</span>
        </div>`).join('') : '<span class="sub">No voice transcripts yet.</span>';
    }

    async function loadProfiles() {
      const res = await fetch('/api/profiles');
      if (!res.ok) throw new Error(`/api/profiles: ${res.status}`);
      const data = await res.json();
      el('profiles').innerHTML = data.available
        ? `<div class="item"><strong>Available profiles</strong><br><span class="sub">${data.profiles.join(', ') || 'No profiles parsed from output.'}</span></div>`
        : `<div class="item"><strong>Profile discovery unavailable</strong><br><span class="sub">${data.error || 'hermes profile list failed'}</span></div>`;
    }

    async function loadProfileMapping() {
      const mapping = await getJson('/api/profile-mapping');
      el('mappingJson').value = JSON.stringify(mapping.mapping, null, 2);
    }

    async function saveProfileMapping() {
      const parsed = JSON.parse(el('mappingJson').value);
      await postJson('/api/profile-mapping', { mapping: parsed });
      await Promise.all([loadProfileMapping(), loadEvents()]);
    }

    async function exportKanban(slug) {
      const result = await postJson(`/api/projects/${slug}/kanban-export`, {});
      alert(`Kanban export created:\n${result.markdown}`);
      await Promise.all([loadEvents(), loadDigest()]);
    }

    async function createRealKanbanTasks(slug) {
      const dryRun = await postJson(`/api/projects/${slug}/kanban-create`, { mode: 'dry-run' });
      const ok = confirm(`Dry run would create ${dryRun.would_create} tasks. Queue approval request for real Kanban creation?`);
      if (!ok) return;
      const result = await postJson(`/api/projects/${slug}/kanban-create`, { mode: 'execute' });
      alert(`Decision: ${result.decision || result.mode}\nApproval: ${result.approval ? result.approval.id : 'n/a'}`);
      await Promise.all([refreshAll(), loadKanbanLinks(slug)]);
    }

    async function loadTasks(slug) {
      const tasks = await getJson(`/api/projects/${slug}/tasks`);
      el('tasks').innerHTML = tasks.length ? tasks.map(t => `
        <div class="item">
          <strong>${t.id}: ${t.objective}</strong><br>
          <span class="status">${t.status}</span> <span class="sub">owner: ${t.owner}</span><br>
          <span class="sub">risk: ${t.risk_level}; artifacts: ${(t.artifacts || []).join(', ') || 'none'}</span>
          ${t.block_reason ? `<br><span class="pending">blocked: ${t.block_reason}</span>` : ''}
          <div>
            <button onclick="setTaskStatus('${slug}', '${t.id}', 'in_progress')">Start</button>
            <button onclick="setTaskStatus('${slug}', '${t.id}', 'review')">Review</button>
            <button onclick="setTaskStatus('${slug}', '${t.id}', 'done')">Done</button>
            <button onclick="blockTask('${slug}', '${t.id}')">Block</button>
          </div>
        </div>`).join('') : '<div class="sub">No tasks found for this project.</div>';
    }

    async function loadKanbanLinks(slug) {
      const data = await getJson(`/api/projects/${slug}/kanban-links`);
      el('kanbanLinks').innerHTML = data.links.length ? data.links.map(link => `
        <div class="item">
          <strong>${link.agentos_task_id}</strong> → <code>${link.hermes_task_id}</code><br>
          <span class="sub">${link.command || ''}</span>
        </div>`).join('') : '<div class="sub">No linked Hermes tasks yet.</div>';
    }

    async function setTaskStatus(slug, taskId, status) {
      await postJson(`/api/projects/${slug}/tasks/${taskId}/status`, { status });
      await loadTasks(slug);
    }

    async function blockTask(slug, taskId) {
      const reason = prompt('Why is this task blocked?');
      if (!reason) return;
      await postJson(`/api/projects/${slug}/tasks/${taskId}/block`, { reason });
      await loadTasks(slug);
    }

    async function approveApproval(id) {
      await postJson(`/api/approvals/${id}/approve`, {});
      await refreshAll();
    }

    async function denyApproval(id) {
      await postJson(`/api/approvals/${id}/deny`, {});
      await refreshAll();
    }

    async function refreshAll() {
      try {
        await Promise.all([loadStatus(), loadDashboardRuntimeDiagnostics(), loadProductionReadiness(), loadProductionReadinessCredentialHandoff(), loadProductionReadinessCredentialHandoffExportPreview(), loadProjects(), loadApprovals(), loadAgentQueue(), loadAgentQueueRuns(), loadAgentWorkerStatus(), loadAgentWorkerRuntimeAudits(), loadAgentWorkerRuntimeConfirmAttempts(), loadAgentWorkerRuntimePreviews(), loadAgentWorkerRuntimeTraceExports(), loadAgentWorkerRuntimeTraceExportStorageSummary(), loadAgentWorkerRuntimeTraceExportRetentionRecommendations(), loadAgentWorkerRuntimeTraceExportRetentionPresets(), loadAgentWorkerRuntimeTraceExportRetentionPresetImpact(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdvice(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceAuditPreview(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceExplanation(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceChecklist(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceChecklistProgress(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceChecklistEvidence(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceChecklistExportPreview(), loadAgentWorkerRuntimeTraceExportRetentionPresetAdviceChecklistExports(), loadAgentWorkerRuntimeTraceExportArchives(), loadAgentWorkerRuntimeTraceExportPruned(), loadEvents(), loadDigest(), loadProfiles(), loadProfileMapping(), loadVoiceConfig(), loadVoiceHealth(), loadVoiceTranscripts(), loadMilaDesktopPackage(), loadMilaTrayPackage(), loadMilaVisualPolish(), loadMilaAgentDock(), loadMilaMemoryGalaxy(), loadMilaAppBuilderBlueprint(), loadMilaKanbanStudio(), loadMilaModelHub()]);
      } catch (err) {
        console.error(err);
        alert(`Dashboard load failed: ${err.message}`);
      }
    }

    async function postJson(path, payload) {
      const res = await fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || `${path}: ${res.status}`);
      return data;
    }

    document.getElementById('goalForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const goal = document.getElementById('goalInput').value.trim();
      if (!goal) return alert('Enter a goal first.');
      await postJson('/api/goals', { goal });
      event.target.reset();
      await refreshAll();
    });

    document.getElementById('commandForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const text = document.getElementById('commandInput').value.trim();
      if (!text) return alert('Enter a command first.');
      const result = await postJson('/api/command', { text });
      document.getElementById('commandResult').textContent = JSON.stringify(result, null, 2);
      await refreshAll();
    });

    document.getElementById('approvalForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const action = document.getElementById('approvalAction').value.trim();
      const summary = document.getElementById('approvalSummary').value.trim();
      if (!action || !summary) return alert('Enter action and summary first.');
      await postJson('/api/approvals/request', { action, summary });
      event.target.reset();
      await refreshAll();
    });

    document.getElementById('profileMappingForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await saveProfileMapping();
        alert('Profile mapping saved.');
      } catch (err) {
        alert(`Invalid mapping or save failed: ${err.message}`);
      }
    });

    window.addEventListener('hashchange', syncMilaRouteFromHash);
    syncMilaRouteFromHash();
    refreshAll();
  </script>
</body>
</html>
